# maze-sim: everything the S1 simulation needs, so nothing is installed on the host.
# Build: ./docker/build.sh    Use: distrobox assemble create --file docker/distrobox.ini
FROM docker.io/osrf/ros:humble-desktop

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-ur \
        ros-humble-ros2-control \
        ros-humble-ros2-controllers \
        ros-humble-xacro \
        ros-humble-mujoco-ros2-control \
        ros-humble-mujoco-ros2-control-plugins \
        ros-humble-launch-testing-ament-cmake \
        python3-pip \
        python3-pytest \
        libegl1 \
        libgl1 \
    && rm -rf /var/lib/apt/lists/*

# System-wide (not --user): distrobox shares the host home, so ~/.local must stay untouched.
# mujoco matches the MuJoCo inside ros-humble-mujoco-vendor (libmujoco.so.3.12.0), so
# Python tests and the plugin compile the scene the same way. trimesh stays on 4.5.x because 5.x
# needs a newer numpy than Ubuntu 22.04's 1.21, which the ROS packages are built against.
RUN pip3 install --no-cache-dir \
        mujoco==3.12.0 \
        coacd==1.0.14 \
        trimesh==4.5.3 \
        rtree==1.3.0

RUN echo 'source /opt/ros/humble/setup.bash' >> /etc/bash.bashrc
