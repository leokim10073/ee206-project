# maze-sim: everything the S1 simulation needs, so nothing is installed on the host.
# Build: ./docker/build.sh    Use: distrobox assemble create --file docker/distrobox.ini
FROM docker.io/osrf/ros:humble-desktop

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-ur \
        ros-humble-ros2-control \
        ros-humble-ros2-controllers \
        ros-humble-xacro \
        ros-humble-mujoco-ros2-control \
        ros-humble-mujoco-ros2-control-plugins \
        ros-humble-launch-testing-ament-cmake \
        python3-pip \
        python3-pytest \
        libegl1 \
        libgl1 \
    && rm -rf /var/lib/apt/lists/*

# System-wide (not --user): distrobox shares the host home, so ~/.local must stay untouched.
# mujoco matches the MuJoCo inside ros-humble-mujoco-vendor (libmujoco.so.3.12.0), so
# Python tests and the plugin compile the scene the same way. trimesh stays on 4.5.x because 5.x
# needs a newer numpy than Ubuntu 22.04's 1.21, which the ROS packages are built against.
RUN pip3 install --no-cache-dir \
        mujoco==3.12.0 \
        coacd==1.0.14 \
        trimesh==4.5.3 \
        rtree==1.3.0 \
        shapely==2.0.6 \
        mapbox_earcut==1.0.2

# Fail here, not in a confusing test later, if apt moved the plugin or its MuJoCo away from the
# versions the sim was tested with (apt versions cannot be pinned: old builds leave the repo).
COPY docker/check_versions.py /tmp/check_versions.py
RUN python3 /tmp/check_versions.py && rm /tmp/check_versions.py

# Whatever the workspace's package.xml files declare (rosdep keys -> apt), so a new dependency
# only needs adding there.
COPY src/maze_sim_description/package.xml /tmp/ws/src/maze_sim_description/package.xml
COPY src/maze_sim_bringup/package.xml /tmp/ws/src/maze_sim_bringup/package.xml
COPY src/maze_sim_nodes/package.xml /tmp/ws/src/maze_sim_nodes/package.xml
RUN apt-get update \
    && rosdep update --rosdistro humble \
    && rosdep install --from-paths /tmp/ws/src --ignore-src --rosdistro humble -y \
    && rm -rf /tmp/ws /var/lib/apt/lists/* /root/.ros

# ROS in every shell: interactive ones read bash.bashrc, login ones (bash -lc ...) read profile.d.
RUN echo 'source /opt/ros/humble/setup.bash' >> /etc/bash.bashrc \
    && echo '. /opt/ros/humble/setup.sh' > /etc/profile.d/ros.sh
