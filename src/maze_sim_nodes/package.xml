<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>maze_sim_nodes</name>
  <version>0.1.0</version>
  <description>C++ nodes and mujoco_ros2_control plugins on the maze simulation's per-cycle paths.</description>
  <maintainer email="leotcchen@berkeley.edu">Leo Chen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>mujoco_ros2_control_msgs</depend>
  <depend>mujoco_ros2_control_plugins</depend>
  <depend>pluginlib</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
